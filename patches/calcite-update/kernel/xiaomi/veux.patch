+#if defined(CONFIG_DRM)
+static ssize_t goodix_display_inactive_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *pos)
+{
+	struct goodix_ts_core *cd = PDE_DATA(file_inode(file));
+	bool inactive;
+	int ret;
+
+	ret = kstrtobool_from_user(buf, count, &inactive);
+	if (ret)
+		return ret;
+
+	WRITE_ONCE(cd->display_inactive, inactive);
+	queue_work(cd->ts_workqueue, &cd->display_state_work);
+	return count;
+}
+
+static const struct file_operations goodix_display_inactive_ops = {
+	.write = goodix_display_inactive_write,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+};
+#endif
